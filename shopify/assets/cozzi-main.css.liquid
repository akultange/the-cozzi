/* The Cozzi first scroll. Same CSS as the spec page. */
@font-face{font-family:"Asap Cozzi";src:url({{ 'asap-cozzi.woff2' | asset_url }}) format("woff2");font-weight:400 720;font-stretch:86% 100%;font-display:swap}
@font-face{font-family:"Asap Fallback";src:local("Arial"),local("Liberation Sans"),local("Helvetica");size-adjust:98.15%;ascent-override:95.16%;descent-override:21.6%;line-gap-override:0%}
:root{
  --night:#191C33;--dusk:#232750;--moon:#ECEAF6;--haze:#A9ABC9;--lamp:#FFC86B;--lamp-hi:#FFD691;
  --sky:#E8EEF7;--paper:#F6F8FB;--ink:#191C33;--slate:#545A78;--rule:#CBD3E3;
  --pillow:#D6D0EC;--seat:#2B3064;--body:#3A4079;--skin:#4A5192;
  --slot:var(--lamp);
  --font:"Asap Cozzi","Asap Fallback",Arial,sans-serif;
  --g:16px;--r-ui:14px;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:var(--font);font-size:16px;line-height:1.5;color:var(--moon);background:var(--night);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
html.lock,html.lock body{overflow:hidden}
[hidden]{display:none!important}
img,svg{display:block;max-width:100%}
a{color:inherit}
button{font:inherit}
:focus-visible{outline:2px solid var(--lamp);outline-offset:3px;border-radius:6px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* Spec mark: always visible, not part of the store */
.specbar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:30px;padding:5px var(--g);background:#0E1024;color:#C7C8DE;font-size:12.5px;line-height:1.3}
.specbar b{color:var(--lamp);font-weight:700;letter-spacing:.02em}
.specbar a{color:var(--moon);text-underline-offset:3px;white-space:nowrap}

/* Product facts only the client knows */
.slot{text-decoration:underline dashed var(--slot);text-decoration-thickness:1.5px;text-underline-offset:4px;text-decoration-skip-ink:none}

.site-header{display:flex;align-items:center;justify-content:space-between;height:52px;padding:0 calc(var(--g) - 4px) 0 var(--g)}
.wordmark{font-size:21px;font-weight:700;font-stretch:90%;letter-spacing:-.015em;text-decoration:none;color:#F4F2FB}
.bag{position:relative;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:12px;background:none;color:var(--moon);cursor:pointer}
.bag svg{width:24px;height:24px}
.bag-count{position:absolute;top:5px;right:3px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--lamp);color:#1B1A2C;font-size:11px;font-weight:700;line-height:18px;text-align:center}
.bag-count[hidden]{display:none}

/* First scroll */
.hero{padding:2px var(--g) 36px}
.window{padding:6px;border-radius:38px;background:linear-gradient(180deg,#2E3367,#242851);box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 18px 40px -24px rgba(0,0,0,.6)}
.window__pane{position:relative;overflow:hidden;border-radius:32px;aspect-ratio:1080/672;background:#2A2E57}
.window__pane img{width:100%;height:100%;object-fit:cover;object-position:var(--focus,50% 40%)}
.standin{position:absolute;left:14px;bottom:12px;padding:3px 8px;border-radius:7px;background:rgba(14,16,36,.74);color:var(--moon);font-size:11.5px;line-height:1.35}
.hero__copy{padding-top:14px}
h1{margin:0;font-size:32px;line-height:1.04;font-weight:700;font-stretch:88%;letter-spacing:-.014em;color:#F6F4FC;text-wrap:balance}
.hero__sub{margin:8px 0 0;max-width:36ch;font-size:15.5px;line-height:1.42;color:var(--haze)}
.claims{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 0;padding:0;list-style:none}
.claim{display:flex;align-items:center;gap:5px;padding:5px 9px 5px 7px;border:1.5px dashed rgba(255,200,107,.6);border-radius:10px;font-size:12.5px;font-weight:600;line-height:1.2;color:var(--moon);white-space:nowrap}
.claim svg{width:16px;height:16px;flex:none;color:var(--lamp)}
.buy{margin-top:14px}
.buy__row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.price{margin:0;font-size:22px;font-weight:700;line-height:1.1;color:#F6F4FC}
.pack{display:flex;gap:3px;margin:0;padding:3px;border:0;border-radius:12px;background:rgba(236,234,246,.09)}
.pack label{position:relative;display:block}
.pack input{position:absolute;inset:0;margin:0;opacity:0;cursor:pointer}
.pack span{display:block;padding:8px 12px;border-radius:9px;font-size:14px;font-weight:600;line-height:1.2;color:var(--haze)}
.pack input:checked+span{background:var(--moon);color:var(--night)}
.pack input:focus-visible+span{outline:2px solid var(--lamp);outline-offset:2px}
.btn-add{display:flex;align-items:center;justify-content:center;width:100%;height:52px;margin:10px 0 0;padding:0 20px;border:0;border-radius:var(--r-ui);background:var(--lamp);color:#1B1A2C;font-size:17px;font-weight:700;letter-spacing:.005em;text-decoration:none;cursor:pointer;transition:background-color .15s}
.btn-add:hover{background:var(--lamp-hi)}
.assure{margin:8px 0 0;font-size:13px;line-height:1.4;color:var(--haze);text-align:center}

/* Why heads drop */
.drop{background:var(--dusk);padding:44px var(--g) 40px}
.drop h2,.rest h2,.trial h2{margin:0;font-size:26px;line-height:1.1;font-weight:700;font-stretch:90%;letter-spacing:-.01em;text-wrap:balance}
.drop p{margin:12px 0 0;max-width:46ch;color:#C9CAE2;font-size:16px}
.drop__figs{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:26px 0 0}
.fig{margin:0}
.fig svg{width:100%;height:auto;border-radius:22px;background:#1D2145}
.fig figcaption{margin-top:10px;font-size:13.5px;line-height:1.35;color:var(--haze)}
.fig figcaption b{display:block;color:var(--moon);font-size:14.5px}
.head{transform-box:view-box;transform-origin:101px 152px}
.fig--drop .head{animation:drop 5.2s cubic-bezier(.45,0,.55,1) infinite}
.fig--hold .head{animation:hold 5.2s ease-in-out infinite}
.jolt{opacity:0;animation:jolt 5.2s linear infinite}
@keyframes drop{0%,16%{transform:rotate(0)}52%{transform:rotate(25deg)}60%{transform:rotate(28deg)}63%{transform:rotate(-4deg)}68%,100%{transform:rotate(0)}}
@keyframes hold{0%,16%{transform:rotate(0)}52%,62%{transform:rotate(5deg)}80%,100%{transform:rotate(0)}}
@keyframes jolt{0%,61%{opacity:0}63%{opacity:1}72%,100%{opacity:0}}

/* Night turns to morning */
.horizon{height:150px;background:linear-gradient(180deg,var(--dusk) 0%,#3C3F73 38%,#9C8FB8 62%,#F3D3B0 78%,var(--sky) 100%)}

.rest{background:var(--sky);color:var(--ink);padding:16px var(--g) 44px}
.rest__grid{display:grid;gap:26px;margin-top:24px}
.point svg{width:28px;height:28px;color:#3B4178}
.point h3{margin:10px 0 0;font-size:19px;line-height:1.2;font-weight:700}
.point p{margin:6px 0 0;max-width:42ch;color:var(--slate)}
.rest .slot,.trial .slot,.notes .slot{--slot:#A06C0C}

.trial{background:var(--paper);color:var(--ink);padding:44px var(--g)}
.trial p{margin:12px 0 0;max-width:48ch;color:var(--slate);font-size:17px}
.trial .btn-add{max-width:360px;margin-top:22px}

/* Notes for the client: clearly outside the store */
.notes{background:#fff;color:var(--ink);padding:48px var(--g) 56px;border-top:1px solid var(--rule)}
.notes__inner{max-width:1080px;margin:0 auto}
.notes h2{margin:0;font-size:28px;line-height:1.1;font-weight:700;font-stretch:90%}
.notes__lede{margin:10px 0 0;max-width:60ch;color:var(--slate);font-size:17px}
.notes__grid{display:grid;gap:36px;margin-top:32px}
.notes h3{margin:0 0 10px;font-size:18px;font-weight:700}
.notes p,.notes li{color:#3D4260;font-size:15.5px}
.notes ul{margin:0;padding-left:18px}
.notes li{margin:4px 0}
.pains{width:100%;border-collapse:collapse;font-size:15px}
.pains th,.pains td{padding:7px 0;border-bottom:1px solid #E3E7F0;text-align:left;font-weight:400}
.pains th{font-size:13px;color:var(--slate)}
.pains td:last-child,.pains th:last-child{text-align:right;font-variant-numeric:tabular-nums}
.pains .bar{display:block;height:4px;margin-top:5px;border-radius:2px;background:#3B4178;width:calc(var(--v) * 4.2%)}
.src{margin-top:10px;font-size:13px!important;color:var(--slate)!important}
.shots{list-style:none;padding:0!important}
.shots li{display:grid;grid-template-columns:88px 1fr;gap:12px;align-items:start;margin:0 0 14px}
.shots .thumb{width:88px;height:66px;border-radius:12px;object-fit:cover;background:#E3E7F0}
.shots .thumb--empty{display:grid;place-items:center;color:var(--slate);font-size:12px;border:1.5px dashed #C2CADA;background:none}
.shots b{display:block;color:var(--ink)}
.speed{display:flex;gap:28px;flex-wrap:wrap;margin:6px 0 0}
.speed div{min-width:90px}
.speed strong{display:block;font-size:30px;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}
.speed span{font-size:13px;color:var(--slate)}

.site-footer{background:#fff;color:var(--slate);padding:0 var(--g) 96px;font-size:13px}
.site-footer p{max-width:1080px;margin:0 auto;padding-top:20px;border-top:1px solid #E3E7F0}

/* Sticky buy bar (mobile) */
.sticky-buy{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;align-items:center;gap:12px;padding:10px var(--g) calc(10px + env(safe-area-inset-bottom));background:rgba(25,28,51,.96);border-top:1px solid rgba(236,234,246,.12);transform:translateY(110%);transition:transform .25s ease;backdrop-filter:blur(8px)}
.sticky-buy.is-on{transform:none}
.sticky-buy img{width:40px;height:40px;border-radius:10px;object-fit:cover}
.sticky-buy__label{flex:1;min-width:0;font-size:13.5px;line-height:1.25;color:var(--haze)}
.sticky-buy__label b{display:block;color:var(--moon);font-size:14.5px}
.sticky-buy .btn-add{width:auto;height:44px;margin:0;font-size:15.5px}

/* Bag drawer */
.scrim{position:fixed;inset:0;z-index:30;background:rgba(10,11,25,.55);opacity:0;transition:opacity .2s}
.scrim.is-open{opacity:1}
.cart{position:fixed;top:0;right:0;bottom:0;z-index:31;display:flex;flex-direction:column;width:min(420px,100vw);background:#fff;color:var(--ink);transform:translateX(100%);transition:transform .25s ease;box-shadow:-20px 0 50px -30px rgba(0,0,0,.5)}
.cart.is-open{transform:none}
.cart__head{display:flex;align-items:center;justify-content:space-between;padding:14px 12px 14px 20px;border-bottom:1px solid #E6E9F1}
.cart__head h2{margin:0;font-size:19px;font-weight:700}
.icon-btn{display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:12px;background:none;color:inherit;cursor:pointer}
.icon-btn svg{width:22px;height:22px}
.cart__body{display:flex;flex:1;flex-direction:column;min-height:0}
.cart__items{flex:1;margin:0;padding:8px 20px;list-style:none;overflow:auto}
.line{display:grid;grid-template-columns:64px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid #EEF1F6}
.line img{width:64px;height:64px;border-radius:12px;object-fit:cover}
.line__name{font-weight:600;line-height:1.25}
.line__meta{font-size:13.5px;color:var(--slate)}
.qty{display:flex;align-items:center;gap:2px;margin-top:6px}
.qty button{width:32px;height:32px;border:1px solid #D9DEEA;border-radius:9px;background:#fff;color:var(--ink);font-size:17px;line-height:1;cursor:pointer}
.qty output{min-width:28px;text-align:center;font-weight:600;font-variant-numeric:tabular-nums}
.line__price{font-size:14.5px;font-weight:600}
.cart__empty{margin:28px 20px;color:var(--slate)}
.cart__foot{padding:16px 20px calc(18px + env(safe-area-inset-bottom));border-top:1px solid #E6E9F1}
.cart__total{display:flex;justify-content:space-between;margin:0;font-size:16px;font-weight:600}
.cart__foot .btn-add{margin-top:12px;background:var(--night);color:#fff}
.cart__foot .btn-add:hover{background:#262A4A}
.cart__note{margin:8px 0 0;font-size:13px;color:var(--slate);text-align:center}
.cart__end{padding:28px 20px}
.cart__end h3{margin:0;font-size:22px;line-height:1.15}
.cart__end p{margin:12px 0 0;color:#3D4260}
.link-btn{margin-top:18px;padding:0;border:0;background:none;color:var(--ink);font-weight:600;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.cart .slot{--slot:#A06C0C}

@media (min-width:700px){
  .drop__figs{max-width:620px}
  .rest__grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}
  .notes__grid{grid-template-columns:1fr 1fr}
}
@media (min-width:960px){
  :root{--g:40px}
  .specbar{justify-content:center;gap:20px;font-size:13px}
  .site-header{height:64px;max-width:1320px;margin:0 auto}
  .wordmark{font-size:24px}
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:64px;align-items:center;max-width:1320px;margin:0 auto;padding:4px var(--g) 72px}
  .window{padding:8px;border-radius:calc(30% + 8px) / calc(24% + 8px)}
  .window__pane{aspect-ratio:4/5;max-height:calc(100vh - 140px);margin:0 auto;border-radius:30% / 24%}
  .standin{left:50%;transform:translateX(-50%);bottom:26px}
  .hero__copy{padding:0;max-width:520px}
  h1{font-size:64px;line-height:.98}
  .hero__sub{margin-top:18px;font-size:19.5px;line-height:1.45}
  .claims{gap:10px;margin-top:22px}
  .claim{padding:8px 12px 8px 10px;font-size:15px}
  .claim svg{width:18px;height:18px}
  .buy{margin-top:30px;max-width:460px}
  .price{font-size:28px}
  .btn-add{height:56px;margin-top:14px;font-size:18px}
  .assure{text-align:left;font-size:14px}
  .drop{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr);gap:64px;align-items:center;padding:88px max(var(--g),calc((100vw - 1240px)/2)) 80px}
  .drop h2,.rest h2,.trial h2{font-size:40px}
  .drop p{font-size:18px}
  .drop__figs{margin:0;gap:20px}
  .rest,.trial{padding-left:max(var(--g),calc((100vw - 1240px)/2));padding-right:max(var(--g),calc((100vw - 1240px)/2))}
  .rest{padding-top:24px;padding-bottom:80px}
  .trial{padding-top:72px;padding-bottom:80px}
  .trial p{font-size:19px}
  .notes{padding:72px var(--g) 80px}
  .notes h2{font-size:36px}
  .sticky-buy{display:none}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .fig--drop .head{animation:none;transform:rotate(25deg)}
  .fig--hold .head,.jolt{animation:none}
  .sticky-buy,.cart,.scrim{transition:none}
}
